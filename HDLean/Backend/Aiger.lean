import HDLean.Backend.Graph
namespace HDLean.Backend

/-- ASCII AIGER 1.9. Each latch initializes to itself (unconstrained), never zero. -/
def aiger (g : Graph) : String := Id.run do
  let m := g.inputs + g.latches + g.gates.size
  let mut lines := #[s!"aag {m} {g.inputs} {g.latches} {g.outputs.size} {g.gates.size}"]
  for k in [:g.inputs] do lines := lines.push s!"{2 * (k + 1)}"
  for k in [:g.latches] do
    let l := 2 * (g.inputs + k + 1)
    lines := lines.push s!"{l} {g.next[k]!} {l}"
  for l in g.outputs do lines := lines.push s!"{l}"
  for gate in g.gates do lines := lines.push s!"{2 * gate.lhs} {gate.a} {gate.b}"
  lines := lines.push "c" |>.push "Generated by HDLean; arbitrary power-up, explicit synchronous reset."
  return String.intercalate "\n" lines.toList ++ "\n"
end HDLean.Backend
